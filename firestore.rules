rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin(campaign) {
      return signedIn() && exists(/databases/$(database)/documents/campaigns/$(campaign)/admins/$(request.auth.uid));
    }

    match /campaigns/{campaign} {

      match /admins/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if isAdmin(campaign);
      }

      match /players/{uid} {
        allow get: if signedIn() && request.auth.uid == uid || isAdmin(campaign);
        allow list: if isAdmin(campaign);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['track', 'startedAt'])
          && request.resource.data.track is string
          && request.resource.data.startedAt == request.time;

        match /days/{day} {
          allow read: if signedIn() && request.auth.uid == uid || isAdmin(campaign);
          allow create: if signedIn() && request.auth.uid == uid
            && day.matches('^[1-9][0-9]{0,2}$')
            && request.resource.data.keys().hasOnly(['slug', 'completedAt'])
            && request.resource.data.slug is string
            && request.resource.data.completedAt == request.time;
        }
      }

      match /profiles/{uid} {
        allow get: if signedIn() && request.auth.uid == uid || isAdmin(campaign);
        allow list: if isAdmin(campaign);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'avatar', 'reason', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && (request.resource.data.avatar == null || request.resource.data.avatar is string && request.resource.data.avatar.size() <= 200)
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 280
          && request.resource.data.updatedAt == request.time;
      }

      match /public/{shareId} {
        allow get: if true;
        allow list: if isAdmin(campaign);
        allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
        allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
