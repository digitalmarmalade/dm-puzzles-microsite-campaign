rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin(campaign) {
      return signedIn() && exists(/databases/$(database)/documents/campaigns/$(campaign)/admins/$(request.auth.uid));
    }

    function validDetails(d) {
      return d.name is string && d.name.size() <= 40
        && (d.avatar == null || d.avatar is string && d.avatar.size() <= 200)
        && d.reason is string && d.reason.size() <= 280
        && d.updatedAt == request.time;
    }

    function validHandle(handle) {
      return handle.size() <= 40
        && handle.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && !(handle in ['profile', 'day', 'days', 'p', 'admin', 'dashboard', 'share', 'public', 'sign-in', 'signin', 'login', 'register', 'settings', 'help', 'about', 'new', 'edit']);
    }

    match /campaigns/{campaign} {

      match /admins/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if isAdmin(campaign);
      }

      match /players/{uid} {
        allow get: if true;
        allow list: if isAdmin(campaign);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['track', 'startedAt'])
          && request.resource.data.track is string
          && request.resource.data.startedAt == request.time;

        match /days/{day} {
          allow read: if true;
          allow create: if signedIn() && request.auth.uid == uid
            && day.matches('^[1-9][0-9]{0,2}$')
            && request.resource.data.keys().hasOnly(['slug', 'completedAt'])
            && request.resource.data.slug is string
            && request.resource.data.completedAt == request.time;
        }
      }

      match /profiles/{uid} {
        allow get: if signedIn() && request.auth.uid == uid || isAdmin(campaign);
        allow list: if isAdmin(campaign);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'avatar', 'reason', 'handle', 'updatedAt'])
          && validDetails(request.resource.data)
          && (request.resource.data.get('handle', null) == null
            || getAfter(/databases/$(database)/documents/campaigns/$(campaign)/public/$(request.resource.data.handle)).data.ownerUid == request.auth.uid);
      }

      match /public/{handle} {
        allow get: if true;
        allow list: if isAdmin(campaign);
        allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'avatar', 'reason', 'updatedAt'])
          && validHandle(handle)
          && validDetails(request.resource.data);
        allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'avatar', 'reason', 'updatedAt'])
          && validDetails(request.resource.data);
        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
