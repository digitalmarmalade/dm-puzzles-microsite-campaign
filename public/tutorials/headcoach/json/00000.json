            "data": [
                {
                    "clue": "How many members were in the original Dumbledore's Army?",
                    "operator": "",
                    "result": 28,
                    "hint": null
                },
                {
                    "clue": "Now add how many Harrys there were on broomsticks at the beginning of Deathly Hallows.",
                    "operator": "+",
                    "result": 35,
                    "hint": "It's the most magical number..."
                },
                {
                    "clue": "How many subjects are studied by first years  at Hogwarts? Subtract this answer from your last!",
                    "operator": "-",
                    "result": 28,
                    "hint": "It's also how many Horcruxes there are. "
                },
                {
                    "clue": "What is the number of times Harry takes the Hogwarts Express in the books? Multiply this answer from your last.",
                    "operator": "x",
                    "result": 140,
                    "hint": "Remember - he doesn't go to Hogwarts in the last book! "
                },
                {
                    "clue": "Now divide that answer by how many siblings  Albus Potter has.",
                    "operator": "&divide;",
                    "result": 70,
                    "hint": "They say good things come in..."
                },
                {
                    "clue": "What day of the month is Hermione's birthday? Add this to your last answer.",
                    "operator": "+",
                    "result": 89,
                    "hint": "It's somewhere in the middle of the month."
                },
                {
                    "clue": "Subtract that by the number of times Harry encounters Voldemort in the stories.",
                    "operator": "-",
                    "result": 81,
                    "hint": "Meeting him via Quirrell and his Tom Riddle memory both count "
                },
                {
                    "clue": "Multiply by how many competitors there were in the Triwizard Tournament.",
                    "operator": "x",
                    "result": 324,
                    "hint": "One more than there SHOULD have been! "
                },
                {
                    "clue": "And divide by the number of of Muggles Sirius Black was accused of murdering at once.",
                    "operator": "&divide;",
                    "result": 27,
                    "hint": "It is also the same number of years he spent in Azkaban."
                },
                {
                    "clue": "Finally, add the total number of points Gryffindor earnt to win the House Cup in Philosopher's Stone.",
                    "operator": "+",
                    "result": 509,
                    "hint": "It's a little less than 500."
                }
            ]
        }
