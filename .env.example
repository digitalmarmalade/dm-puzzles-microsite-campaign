# Copy to .env for local development (`npm run dev`), or to .env.rasp for
# `npm run rasp`. Deploys don't use this file: each GitHub environment (Games,
# RASP) holds these as variables and the workflow writes them into .env.
# Leave a line out (or commented) to use the default.

# Base path the site is served from.
NUXT_APP_BASE_URL=/

# Puzzle archive the site loads. Default: /archive.json
DM_ARCHIVE_FILE=/archive.json

# Local dev only: proxy /gameplay/ (puzzles and practice puzzles) to another host.
# DM_GAMEPLAY_ORIGIN=https://games.stickypuzzles.com

# Firebase: either point at a JSON config file served next to the site...
FIREBASE_CONFIG_FILE=/firebaseConfig.json
# ...or leave FIREBASE_CONFIG_FILE unset and give the config directly.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_DATABASE_URL=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=

# Public URL, used for the Open Graph / Twitter tags. Default: https://games.stickypuzzles.com
# NUXT_PUBLIC_SITE_URL=

# Languages to build, comma-separated; the first is the default. Default: all
# (en, fr, it, de, es, hu, pl). Example for the Polish-only RASP site: pl
# SITE_LOCALES=

# Feature flags, all on by default. Set to false to switch one off.
# NUXT_PUBLIC_FEATURES_REQUIRE_ACCOUNT=false
# NUXT_PUBLIC_FEATURES_ACCOUNT=false
# NUXT_PUBLIC_FEATURES_FRIENDS=false
# NUXT_PUBLIC_FEATURES_ACHIEVEMENTS=false
# NUXT_PUBLIC_FEATURES_STATS=false
# NUXT_PUBLIC_FEATURES_CHALLENGES=false
# NUXT_PUBLIC_FEATURES_STREAK_FREEZE=false
# NUXT_PUBLIC_FEATURES_INSTALL_PROMPT=false
# NUXT_PUBLIC_FEATURES_ADVENT=false

# Off by default. Set to true to switch one on.
# NUXT_PUBLIC_FEATURES_CHANGELOG=true
# NUXT_PUBLIC_FEATURES_LEVEL_NUDGE=true
