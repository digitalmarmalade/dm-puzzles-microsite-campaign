# Copy to .env for local development (`npm run dev`), or to .env.local for
# `npm run local`. Deploys don't use this file: the Campaigns GitHub environment
# holds these as variables and the workflow writes them into .env.
# Leave a line out (or commented) to use the default.

# Base path the site is served from.
NUXT_APP_BASE_URL=/

# Local dev only: proxy /gameplay/ (puzzles and practice puzzles) to another host.
# DM_GAMEPLAY_ORIGIN=https://games.stickypuzzles.com

# Firebase: either point at a JSON config file served next to the site...
FIREBASE_CONFIG_FILE=/firebaseConfig.json
# ...or leave FIREBASE_CONFIG_FILE unset and give the config directly.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_DATABASE_URL=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
